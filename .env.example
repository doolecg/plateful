# Larder settings. install.sh writes this file for you; edit it by hand if you prefer.
# After changing it, run: docker compose up -d

# Sign Larder in to Claude with ONE of these two (see SETUP.md, step 2).
# A) Claude Pro or Max subscription: run `claude setup-token` and paste what it prints
CLAUDE_CODE_OAUTH_TOKEN=
# B) Or an API key from console.anthropic.com (paid per message instead)
ANTHROPIC_API_KEY=

# Your time zone, so "today" starts at your midnight
TZ=Europe/London

# Port on this computer (change it if 8080 is taken)
LARDER_PORT=8080

# Only if Larder is reachable from the internet (not needed at home or on Tailscale):
# a household password everyone types once per device, and your domain name for HTTPS.
LARDER_PASSWORD=
LARDER_DOMAIN=
