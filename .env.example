# Plateful settings. install.sh writes this file for you; edit it by hand if you prefer.
# After changing it, run: docker compose up -d --build

# ---- Which AI reads your food (see SETUP.md, "Choosing an AI") ----
# claude | codex | gemini | opencode | ollama | openai | custom
PLATEFUL_AI=claude
# Command-line tools to build into Plateful, space-separated (claude, codex, gemini, opencode, or none)
PLATEFUL_CLIS=claude
# Models for typed messages and for photos. Leave empty for the AI's own defaults
# (Claude: claude-haiku-5-5 for typing, claude-sonnet-5-5 for photos).
PLATEFUL_TEXT_MODEL=
PLATEFUL_PHOTO_MODEL=
# Set to false if your model can't see pictures; Plateful then reads only the words you send
PLATEFUL_AI_IMAGES=
# Seconds to wait for a reply (raise it for slow local models)
PLATEFUL_AI_TIMEOUT=180

# Claude: ONE of these. A subscription token from `claude setup-token`, or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# OpenAI Codex: an API key (or sign in with ChatGPT, see SETUP.md)
CODEX_API_KEY=
# Gemini CLI: an API key from Google AI Studio
GEMINI_API_KEY=
# Ollama: where it's running (this default reaches Ollama on the same computer)
OLLAMA_HOST=http://host.docker.internal:11434
# OpenAI-compatible server (llama.cpp's llama-server, LM Studio, vLLM, OpenRouter...)
PLATEFUL_AI_URL=
PLATEFUL_AI_KEY=
# Custom: any shell command that prints the JSON. Placeholders: {prompt_file} {prompt} {image} {images} {model}
PLATEFUL_AI_COMMAND=

# ---- Everything else ----
# Your time zone, so "today" starts at your midnight
TZ=Europe/London
# Port on this computer (change it if 8080 is taken)
PLATEFUL_PORT=8080
# Only if Plateful is reachable from the internet (not needed at home or on Tailscale):
# a household password everyone types once per device, and your domain name for HTTPS.
PLATEFUL_PASSWORD=
PLATEFUL_DOMAIN=
